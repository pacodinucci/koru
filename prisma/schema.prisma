generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                      @id
  name                       String
  email                      String
  role                       UserRole                    @default(PARENT)
  emailVerified              Boolean                     @default(false)
  image                      String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  sessions                   Session[]
  accounts                   Account[]
  blogLikes                  BlogPostLike[]
  createdCalendarEvents      CalendarEvent[]             @relation("CalendarEventCreator")
  calendarEventAudiences     CalendarEventAudience[]
  calendarEventRegistrations CalendarEventRegistration[]
  calendarEventAttendances   CalendarEventAttendance[]
  googleCalendarConnection   GoogleCalendarConnection?
  uploadedMediaAssets        MediaAsset[]
  createdInvitations         UserInvitation[]            @relation("UserInvitationsCreated")
  teacherProfile             TeacherProfile?
  studentGuardianLinks       StudentGuardian[]
  familyProfile              FamilyProfile?
  familyId                   String?
  family                     Family?                     @relation(fields: [familyId], references: [id], onDelete: SetNull)

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                       String                    @id
  accountId                String
  providerId               String
  userId                   String
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken              String?
  refreshToken             String?
  idToken                  String?
  accessTokenExpiresAt     DateTime?
  refreshTokenExpiresAt    DateTime?
  scope                    String?
  password                 String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  googleCalendarConnection GoogleCalendarConnection?

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BlockType {
  HERO
  RICH_TEXT
  CTA
  IMAGE
  DONATION
}

enum DonationProvider {
  MERCADO_PAGO
  STRIPE
  PAYPAL
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
}

enum BlogPostVisibility {
  PUBLIC
  MEMBERS
}

enum BlogTagType {
  GROUP
  CUSTOM
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum EmailMessageType {
  USER_INVITATION
  CALENDAR_EVENT
  BLOG_POST
  MANUAL
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum UserRole {
  ADMIN
  ADMIN_TEACHER
  SUPERADMIN
  TEACHER
  PARENT
}

enum FamilyStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

model Family {
  id              String       @id @default(cuid())
  name            String
  status          FamilyStatus @default(ACTIVE)
  streetAndNumber String?
  neighborhood    String?
  cityAndState    String?
  postalCode      String?
  notes           String?
  planId          String?
  plan            Plan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  users           User[]
  students        Student[]
  accountEntries  FamilyAccountEntry[]
  payments        FamilyPayment[]
  invitations     UserInvitation[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([status])
  @@index([planId])
}

model Plan {
  id         String   @id @default(cuid())
  name       String   @unique
  monthlyFee Decimal  @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  families   Family[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
}

enum AccountEntryType {
  MONTHLY_CHARGE
  PAYMENT
  PAYMENT_REVERSAL
  BALANCE_WAIVER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentStatus {
  REGISTERED
  VOIDED
}

enum ReceiptStatus {
  ACTIVE
  VOIDED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum StudentRecordStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  NEEDS_CHANGES
}

enum StudentGuardianRelationship {
  MOTHER
  FATHER
  TUTOR
  GUARDIAN
  OTHER
}

enum CalendarEventStatus {
  DRAFT
  PUBLISHED
  CANCELED
}

enum CalendarEventVisibility {
  PUBLIC
  MEMBERS
}

enum CalendarAudienceType {
  ALL
  TEACHERS
  PARENTS
  PRIVATE
}

enum CalendarEventKind {
  EVENT
  MEETING
}

enum CalendarRegistrationAccess {
  PUBLIC
  MEMBERS
}

enum CalendarAttendanceStatus {
  PENDING
  CONFIRMED
  DECLINED
}

enum GoogleCalendarConnectionStatus {
  ACTIVE
  NEEDS_REAUTH
  DISABLED
}

enum GoogleCalendarSyncStatus {
  PENDING
  SYNCED
  FAILED
  REMOVED
}

enum MediaAssetPurpose {
  BLOG
  CALENDAR
  CMS
}

enum ExamStatus {
  DRAFT
  PUBLISHED
}

model Page {
  id             String      @id @default(cuid())
  slug           String      @unique
  title          String
  status         PageStatus  @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  blocks         PageBlock[]
  donations      Donation[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model PageBlock {
  id        String    @id @default(cuid())
  pageId    String
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      BlockType
  order     Int
  data      Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([pageId, order])
  @@index([pageId, type])
}

model Donation {
  id          String           @id @default(cuid())
  provider    DonationProvider
  providerRef String?          @unique
  amount      Decimal          @db.Decimal(10, 2)
  currency    String           @default("ARS")
  donorName   String?
  donorEmail  String?
  status      DonationStatus   @default(PENDING)
  pageId      String?
  page        Page?            @relation(fields: [pageId], references: [id], onDelete: SetNull)
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  completedAt DateTime?
}

model CmsTextEntry {
  key            String   @id
  draftValue     String
  publishedValue String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CmsImageEntry {
  id                String   @id @default(cuid())
  pageSlug          String
  key               String
  draftUrl          String
  draftPublicId     String
  publishedUrl      String?
  publishedPublicId String?
  draftCropX         Float    @default(50)
  draftCropY         Float    @default(50)
  draftZoom          Float    @default(1)
  draftFitMode       String   @default("COVER")
  draftFrameSize     String   @default("NORMAL")
  publishedCropX     Float?
  publishedCropY     Float?
  publishedZoom      Float?
  publishedFitMode   String?
  publishedFrameSize String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([pageSlug, key])
  @@index([pageSlug])
  @@index([draftPublicId])
  @@index([publishedPublicId])
}

model BlogPost {
  id            String             @id @default(cuid())
  slug          String             @unique
  title         String
  excerpt       String
  content       String
  contentBlocks Json?
  status        BlogPostStatus     @default(DRAFT)
  visibility    BlogPostVisibility @default(PUBLIC)
  authorName    String?
  publishedAt   DateTime?
  comments      BlogComment[]
  likes         BlogPostLike[]
  tags          BlogPostTag[]
  mediaAssets   MediaAsset[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, publishedAt])
  @@index([status, visibility, publishedAt])
}

model BlogTag {
  id        String        @id @default(cuid())
  name      String
  slug      String        @unique
  type      BlogTagType   @default(CUSTOM)
  groupId   String?
  group     StudentGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  posts     BlogPostTag[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([type])
  @@index([groupId])
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model BlogPostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId, createdAt])
}

model BlogComment {
  id          String   @id @default(cuid())
  postId      String
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String?
  content     String
  approved    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([postId, approved, createdAt])
}

model ContactMessage {
  id        String               @id @default(cuid())
  nombre    String
  email     String
  telefono  String?
  mensaje   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status, createdAt])
}

model UserInvitation {
  id          String           @id @default(cuid())
  email       String
  role        UserRole         @default(PARENT)
  familyId    String?
  family      Family?          @relation(fields: [familyId], references: [id], onDelete: SetNull)
  status      InvitationStatus @default(PENDING)
  tokenHash   String?
  expiresAt   DateTime?
  lastSentAt  DateTime?
  invitedById String?
  invitedBy   User?            @relation("UserInvitationsCreated", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([email])
  @@index([status, createdAt])
  @@index([invitedById])
  @@index([familyId, status])
  @@index([expiresAt])
}

model EmailMessage {
  id                String              @id @default(cuid())
  type              EmailMessageType
  subject           String
  from              String
  status            EmailDeliveryStatus @default(PENDING)
  provider          String              @default("resend")
  providerMessageId String?
  payload           Json?
  error             String?
  recipients        EmailRecipient[]
  sentAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([type, createdAt])
  @@index([status, createdAt])
}

model EmailRecipient {
  id        String              @id @default(cuid())
  messageId String
  message   EmailMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  email     String
  name      String?
  status    EmailDeliveryStatus @default(PENDING)
  error     String?
  sentAt    DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([messageId])
  @@index([email])
  @@index([status, createdAt])
}

model FamilyProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  streetAndNumber String?
  neighborhood    String?
  cityAndState    String?
  postalCode      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FamilyAccountEntry {
  id          String           @id @default(cuid())
  familyId    String
  family      Family           @relation(fields: [familyId], references: [id], onDelete: Restrict)
  type        AccountEntryType
  amount      Decimal          @db.Decimal(12, 2)
  description String
  occurredAt  DateTime         @default(now())
  billingPeriod DateTime?       @db.Date
  paymentId   String?          @unique
  payment     FamilyPayment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime         @default(now())

  @@index([familyId, occurredAt])
  @@unique([familyId, billingPeriod])
}

model FamilyPayment {
  id            String        @id @default(cuid())
  familyId      String
  family        Family        @relation(fields: [familyId], references: [id], onDelete: Restrict)
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  reference     String?
  attachmentUrl String?
  status        PaymentStatus @default(REGISTERED)
  paidAt        DateTime      @default(now())
  voidedAt      DateTime?
  voidReason    String?
  createdById   String
  accountEntry  FamilyAccountEntry?
  receipt       PaymentReceipt?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([familyId, paidAt])
  @@index([status, paidAt])
}

model PaymentReceipt {
  id         String        @id @default(cuid())
  paymentId  String        @unique
  payment    FamilyPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  number     Int           @unique
  status     ReceiptStatus @default(ACTIVE)
  pdfUrl     String?
  pdfPublicId String?
  deliveries ReceiptDelivery[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model ReceiptDelivery {
  id        String              @id @default(cuid())
  receiptId String
  receipt   PaymentReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  email     String
  status    EmailDeliveryStatus @default(PENDING)
  error     String?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([receiptId, createdAt])
}

model StudentGroup {
  id                      String                @id @default(cuid())
  name                    String
  slug                    String                @unique
  ageRange                String
  description             String?
  sortOrder               Int                   @default(0)
  isActive                Boolean               @default(true)
  students                Student[]
  teacherResponsibilities StudentGroupTeacher[]
  exams                   Exam[]
  blogTags                BlogTag[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@index([isActive, sortOrder])
}

model TeacherProfile {
  id                    String                @id @default(cuid())
  userId                String?               @unique
  user                  User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName           String
  email                 String?
  phone                 String?
  bio                   String?
  isActive              Boolean               @default(true)
  groupResponsibilities StudentGroupTeacher[]
  exams                 Exam[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([isActive, displayName])
  @@index([email])
}

model StudentGroupTeacher {
  id        String         @id @default(cuid())
  groupId   String
  group     StudentGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([groupId, teacherId])
  @@index([groupId])
  @@index([teacherId])
}

model Student {
  id                String                 @id @default(cuid())
  firstName         String
  lastName          String
  documentType      String?
  documentNumber    String?
  birthDate         DateTime
  groupId           String
  group             StudentGroup           @relation(fields: [groupId], references: [id], onDelete: Restrict)
  familyId          String?
  family            Family?                 @relation(fields: [familyId], references: [id], onDelete: SetNull)
  status            StudentStatus          @default(ACTIVE)
  recordStatus      StudentRecordStatus    @default(DRAFT)
  recordStep        Int                    @default(1)
  recordCompletedAt DateTime?
  notes             String?
  address           StudentAddress?
  medicalProfile    StudentMedicalProfile?
  responsibles      StudentResponsible[]
  guardians         StudentGuardian[]
  examGrades        ExamGrade[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([documentType, documentNumber])
  @@index([groupId, status])
  @@index([recordStatus, updatedAt])
  @@index([lastName, firstName])
  @@index([familyId])
}

model StudentAddress {
  id              String   @id @default(cuid())
  studentId       String   @unique
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  streetAndNumber String
  neighborhood    String
  cityAndState    String
  postalCode      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StudentMedicalProfile {
  id                         String   @id @default(cuid())
  studentId                  String   @unique
  student                    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bloodType                  String?
  knownAllergies             String?
  medicalConditions          String?
  regularMedications         String?
  hasHealthInsurance         Boolean  @default(false)
  insuranceProviderAndPolicy String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model StudentResponsible {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fullName         String
  relationship     String
  phone            String
  priority         Int      @default(1)
  canPickup        Boolean  @default(false)
  emergencyContact Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([studentId, priority])
  @@map("StudentEmergencyContact")
}

model Exam {
  id          String         @id @default(cuid())
  groupId     String
  group       StudentGroup   @relation(fields: [groupId], references: [id], onDelete: Restrict)
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  title       String
  subject     String?
  examDate    DateTime
  description String?
  status      ExamStatus     @default(DRAFT)
  grades      ExamGrade[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([groupId, examDate])
  @@index([teacherId, examDate])
  @@index([status, examDate])
}

model ExamGrade {
  id           String   @id @default(cuid())
  examId       String
  exam         Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score        Decimal  @db.Decimal(5, 2)
  observations String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([examId, studentId])
  @@index([studentId])
}

model StudentGuardian {
  id               String                      @id @default(cuid())
  studentId        String
  student          Student                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email            String
  fullName         String?
  phone            String?
  relationship     StudentGuardianRelationship @default(GUARDIAN)
  isPrimary        Boolean                     @default(false)
  canPickup        Boolean                     @default(false)
  emergencyContact Boolean                     @default(false)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@unique([studentId, email])
  @@index([userId])
  @@index([email])
}

model CalendarEvent {
  id                            String                      @id @default(cuid())
  title                         String
  description                   String?
  imageUrl                      String?
  imagePublicId                 String?
  startsAt                      DateTime
  endsAt                        DateTime
  allDay                        Boolean                     @default(false)
  location                      String?
  status                        CalendarEventStatus         @default(DRAFT)
  visibility                    CalendarEventVisibility     @default(MEMBERS)
  audienceType                  CalendarAudienceType        @default(ALL)
  kind                          CalendarEventKind           @default(EVENT)
  registrationsEnabled          Boolean                     @default(false)
  attendanceConfirmationEnabled Boolean                     @default(false)
  registrationAccess            CalendarRegistrationAccess  @default(PUBLIC)
  createdById                   String
  createdBy                     User                        @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: Restrict)
  audiences                     CalendarEventAudience[]
  registrations                 CalendarEventRegistration[]
  attendances                   CalendarEventAttendance[]
  googleCalendarSyncs           GoogleCalendarEventSync[]
  mediaAssets                   MediaAsset[]
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt

  @@index([startsAt, endsAt])
  @@index([status, audienceType])
  @@index([status, visibility, startsAt])
}

model MediaAsset {
  id              String            @id @default(cuid())
  url             String            @unique
  publicId        String            @unique
  purpose         MediaAssetPurpose
  uploadedById    String
  uploadedBy      User              @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  blogPostId      String?
  blogPost        BlogPost?         @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  calendarEventId String?
  calendarEvent   CalendarEvent?    @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  createdAt       DateTime          @default(now())
  attachedAt      DateTime?

  @@index([purpose, uploadedById, attachedAt])
  @@index([blogPostId])
  @@index([calendarEventId])
}

model CalendarEventAudience {
  id        String        @id @default(cuid())
  eventId   String
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model CalendarEventRegistration {
  id        String        @id @default(cuid())
  eventId   String
  event     CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  phone     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([eventId, userId])
  @@unique([eventId, email])
  @@index([eventId, createdAt])
  @@index([userId])
}

model CalendarEventAttendance {
  id               String                   @id @default(cuid())
  eventId          String
  event            CalendarEvent            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name             String
  email            String
  status           CalendarAttendanceStatus @default(PENDING)
  invitationSentAt DateTime?
  invitationError  String?
  respondedAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@unique([eventId, userId])
  @@unique([eventId, email])
  @@index([eventId, status])
  @@index([userId])
  @@index([invitationSentAt])
}

model GoogleCalendarConnection {
  id                  String                         @id @default(cuid())
  userId              String                         @unique
  user                User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId           String                         @unique
  account             Account                        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  calendarId          String                         @default("primary")
  status              GoogleCalendarConnectionStatus @default(ACTIVE)
  syncConfirmedEvents Boolean                        @default(true)
  lastError           String?
  connectedAt         DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt
  eventSyncs          GoogleCalendarEventSync[]

  @@index([status])
}

model GoogleCalendarEventSync {
  id            String                   @id @default(cuid())
  connectionId  String
  connection    GoogleCalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  eventId       String
  event         CalendarEvent            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  googleEventId String?
  status        GoogleCalendarSyncStatus @default(PENDING)
  lastError     String?
  lastSyncedAt  DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@unique([connectionId, eventId])
  @@index([eventId, status])
  @@index([googleEventId])
}
